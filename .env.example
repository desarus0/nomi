# Supabase project (Project Settings → API). The anon/publishable key is safe in the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only: Google Places API (New). Leave empty to use built-in sample restaurants.
GOOGLE_PLACES_API_KEY=
